# Memorial Website Configuration
# Copy this file to .env and fill in your values.

# Server port (default: 3000)
PORT=3000

# Name of the person being remembered
PERSON_NAME=Your Loved One's Name

# Life dates, e.g. "January 1, 1940 – December 25, 2023"
PERSON_DATES=

# A short tribute shown beneath the name
PERSON_BIO=

# Family access code — share this only with immediate family
# Anyone with this code can view family-only posts
FAMILY_CODE=family
